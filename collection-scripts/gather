SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=collection-scripts/gather_utils
source "${SCRIPT_DIR}/gather_utils"

export MCE_NAME=""
export OPERATOR_NAMESPACE=""
export DEPLOYMENT_NAMESPACE=""
export HC_NAME=""
export HC_NAMESPACE="clusters" # default hosted cluster namespace
export PRODUCT="acm"
export IS_ENGINE=false
export IS_HUB=false
export IS_OBS_HUB=false

parse_args "$@"

pids=()

log "Starting ACM must-gather..."

if check_if_engine; then
  IS_ENGINE=true

  if check_if_hub; then
    IS_HUB=true
    if check_if_obs_hub; then
      IS_OBS_HUB=true
    fi

    log "Running ACM MultiClusterHub Must-Gather"
    "${SCRIPT_DIR}/gather_all_logs" &
    pids+=($!)
  fi

  log "Running MulticlusterEngine Must-Gather"
  "${SCRIPT_DIR}/mce/gather_mce_logs" &
  pids+=($!)
fi

if check_if_spoke; then
  log "Running spoke cluster must-gather"
  "${SCRIPT_DIR}/gather_spoke_logs" &
  pids+=($!)
fi

dump_hostedcluster &
pids+=($!)

# Check if PID array has any values, if so, wait for them to finish
if [ ${#pids[@]} -ne 0 ]; then
    log "All ACM must-gather scripts have started. Waiting on subprocesses to finish execution."
    wait "${pids[@]}"
    log "All ACM must-gather scripts have completed."
fi

log "ACM must-gather complete."
