#! /bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
export PRODUCT=${PRODUCT:-acm}

# shellcheck source=collection-scripts/mce/gather_utils
source "${SCRIPT_DIR}/mce/gather_utils"

get_acm_hub_namespace() {
  oc get multiclusterhubs.operator.open-cluster-management.io --all-namespaces -o jsonpath='{.items[*].metadata.namespace}'
}

export CONTEXT_GATHERED=${CONTEXT_GATHERED:-"false"}

if [[ -n "${GATHER_CONTEXT}" ]] && [[ "${CONTEXT_GATHERED}" == "false" ]]; then
  CONTEXT_GATHERED="true"
  pids=()
  case "${GATHER_CONTEXT}" in
  "true")
    "${SCRIPT_DIR}/mce/gather_mce_logs" &
    pids+=($!)
    "${SCRIPT_DIR}/gather_hub_logs" &
    pids+=($!)
    ;;
  "minimal")
    run_inspect ns/"$(get_acm_hub_namespace)" &
    pids+=($!)
    ;;
  *)
    log "WARN" "Invalid GATHER_CONTEXT value: ${GATHER_CONTEXT}"
    ;;
  esac
  if [ ${#pids[@]} -ne 0 ]; then
    log "All ACM hub must-gather scripts have started. Waiting on subprocesses to finish execution."
    wait "${pids[@]}"
    log "All ACM hub must-gather scripts have completed."
  fi
fi

check_if_hub() {
  log "Detecting Hub cluster by fetching MultiClusterHub (MCH) resource..."
  if output=$(get_acm_hub_namespace 2>&1) && [[ -n "${output}" ]]; then
    log "Detected MCH resource. This cluster has been verified as a hub cluster."
    return 0
  fi

  if [[ -n "${output}" ]]; then
    log "$(printf "No MCH resource detected on the current cluster. This is not a hub cluster:\n\t\t%s" "${output}")"
    return 1
  fi

  log "No MCH resource detected on the current cluster. This is not a hub cluster."
  return 1
}

check_if_acm_spoke() {
  log "Detecting ACM Managed cluster by fetching Policy CRD..."
  if detect_kind crd/policies.policy.open-cluster-management.io; then
    log "The current cluster has policies.policy.open-cluster-management.io CRD, it is an ACM spoke cluster."
    return 0
  fi

  log "The current cluster does not have policies.policy.open-cluster-management.io CRD, it is not an ACM spoke cluster."
  return 1
}

check_if_obs_hub() {
  log "Checking if Observability is enabled by fetching MCO resource..."
  if detect_kind multiclusterobservabilities.observability.open-cluster-management.io; then
    log "Detected MCO resource. Observability is enabled."
    return 0
  fi

  log "No MCO resource detected on the current cluster. Observability is not enabled."
  return 1
}

check_if_globalhub() {
  log "Checking if GlobalHub is enabled by fetching MultiClusterGlobalHub resource..."
  if detect_kind multiclusterglobalhubs.operator.open-cluster-management.io; then
    log "Detected MultiClusterGlobalHub resource. GlobalHub is enabled."
    return 0
  fi

  log "No MultiClusterGlobalHub resource detected on the current cluster. GlobalHub is not enabled."
  return 1
}
