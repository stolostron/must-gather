#! /bin/bash

BASE_COLLECTION_PATH=${BASE_COLLECTION_PATH:-"./must-gather"}

# log produces a formatted log string with component, level, and message positional arguments:
# - 1 argument:  Log message (default log level)
# - 2 arguments: Custom log level and message
log() {
  lvl="${1}"
  msg="${2}"

  if [[ "$#" == "1" ]]; then
    msg="${1}"
    lvl="INFO"
  fi

  case ${lvl} in
    INFO | WARN | DEBUG | ERROR);;
    *) lvl="INFO";;
  esac

  printf "%s\tacm-must-gather\t%s\n" "${lvl}" "${msg}"
}

# print_header prints an underlined heading with a trailing newline
print_with_header() {
  header=${1}
  content=${2}
  # shellcheck disable=SC2001
  underline=$(echo "${header}" | sed 's/./-/g')

  printf "%s\n%s\n%s\n\n" "${header}" "${underline}" "${content}"
}

# run_inspect wraps `oc adm inspect` by logging the args and running it with common flags
run_inspect() {
  args="$*"
  log "Inspecting ${args}"
  # shellcheck disable=SC2086
  # - BASE_COLLECTION_PATH can't be quoted because `oc` reads the quotes as part of the path
  oc adm inspect --dest-dir=${BASE_COLLECTION_PATH} "$@"
}

# Each potentially sensitive kind and "wrapper" kind should have an entry in this definition.
# Using a jq `def` ensures that this can recursively descend through multiple "wrapper" kinds.
# Separating each kind into a separate `def` would cause problems with how `jq` parses this.
# The "last-applied-configuration" annotation is always redacted: it could contain sensitive
# information, and it's easiest to just treat it as noise.
REDACT_DEF='
def redact_manifest: (
  (if .metadata.annotations["kubectl.kubernetes.io/last-applied-configuration"] then
    .metadata.annotations["kubectl.kubernetes.io/last-applied-configuration"] = "REDACTED"
  else . end) |
  if .kind == "Secret" and .apiVersion == "v1" then
    (if has("data") then .data |= map_values("REDACTED") else . end) |
    (if has("stringData") then .stringData |= map_values("REDACTED") else . end) |
    (if .metadata.annotations["openshift.io/token-secret.value"] then
      .metadata.annotations["openshift.io/token-secret.value"] = "REDACTED"
    else . end)
  elif .kind == "Route" and .apiVersion == "route.openshift.io/v1" then
    (if has("spec") then .spec |= (
      if .tls then .tls |=
        (if has("key") then .key = "REDACTED" else . end)
      else . end
    ) else . end)
  elif .kind == "Proxy" and .apiVersion == "config.openshift.io/v1" then
    (if has("spec") then .spec |= (
      (if has("httpProxy") then .httpProxy = "REDACTED" else . end) |
      (if has("httpsProxy") then .httpsProxy = "REDACTED" else . end)
    ) else . end) |
    (if has("status") then .status |= (
      (if has("httpProxy") then .httpProxy = "REDACTED" else . end) |
      (if has("httpsProxy") then .httpsProxy = "REDACTED" else . end)
    ) else . end)
  elif .kind == "OAuthClient" and .apiVersion == "oauth.openshift.io/v1" then
    (if has("secret") then .secret = "REDACTED" else . end) |
    (if has("additionalSecrets") then .additionalSecrets |= map("REDACTED") else . end)
  elif .kind == "ConfigurationPolicy" and .apiVersion == "policy.open-cluster-management.io/v1" then
    (if .spec["object-templates"] then .spec["object-templates"] |=
      map(.objectDefinition |= redact_manifest) else . end)
  elif .kind == "Policy" and .apiVersion == "policy.open-cluster-management.io/v1" then
    (if .spec["policy-templates"] then .spec["policy-templates"] |=
      map(.objectDefinition |= redact_manifest) else . end)
  elif .kind == "AddOnTemplate" and .apiVersion == "addon.open-cluster-management.io/v1alpha1" then
    (if .spec.agentSpec.workload.manifests then .spec.agentSpec.workload.manifests |=
      map(redact_manifest) else . end)
  elif .kind == "ManifestWork" and .apiVersion == "work.open-cluster-management.io/v1" then
    (if .spec.workload.manifests then .spec.workload.manifests |=
      map(redact_manifest) else . end)
  elif .kind == "SyncSet" and .apiVersion == "hive.openshift.io/v1" then
    (if .spec.resources then .spec.resources |=
      map(redact_manifest) else . end)
  elif .kind == "SelectorSyncSet" and .apiVersion == "hive.openshift.io/v1" then
    (if .spec.resources then .spec.resources |=
      map(redact_manifest) else . end)
  else .
  end
);
'

# safe_inspect is meant for "wrapper" resources like ManifestWork and ConfigurationPolicy,
# which may contain nested resources with sensitive information that should be redacted.
# Note that the resulting files are stored in the usual places, but are JSON, not YAML.
# The filter recurses through any nested "wrapper" kind it recognizes, so a Secret
# in an AddOnTemplate in a ManifestWork is still properly redacted.
safe_inspect() {
  local kind="${1}"
  local api_group="${2}"

  log "Safely inspecting ${kind}.${api_group} --all-namespaces"

  local items
  items="$(oc get "${kind}.${api_group}" "--all-namespaces" -o json 2>/dev/null)" || return 0

  echo "${items}" | jq -c '.items[]' | while IFS= read -r item; do
    local ns name
    ns=$(echo "${item}" | jq -r '.metadata.namespace')
    name=$(echo "${item}" | jq -r '.metadata.name')

    local dest_dir
    if [[ "${ns}" == "null" ]]; then
      dest_dir="${BASE_COLLECTION_PATH}/cluster-scoped-resources/${api_group}/${kind}"
    else
      dest_dir="${BASE_COLLECTION_PATH}/namespaces/${ns}/${api_group}/${kind}"
    fi

    # skip if already collected
    [ -f "${dest_dir}/${name}.json" ] && continue

    mkdir -p "${dest_dir}"

    # Use an intermediate temporary file to avoid multiple streams to the same file.
    local tmp_file
    if ! tmp_file="$(mktemp "${dest_dir}/.${name}.json.XXXXXX")"; then
      log "ERROR" "Unable to inspect ${dest_dir}/.${name}"
      continue
    fi

    if ! jq "${REDACT_DEF}"' redact_manifest' <<<"${item}" >"${tmp_file}"; then
      log "ERROR" "Unable to inspect ${dest_dir}/.${name}"
      rm -f "${tmp_file}"
    else
      mv -f "${tmp_file}" "${dest_dir}/${name}.json"
    fi
  done
}

# parse_args parses the arguments passed to the must-gather in the form of <key>=<value>.
# NOTE: Currently this only applies to the Hypershift must-gather.
parse_args() {
  # get the hosted cluster name and optionally namespace
  while [ "${1}" != "" ]; do
    local key value
    key=${1%=*}
    value=${1#*=}
    case ${key} in
    hosted-cluster-name) # Get the hosted cluster name
      export HC_NAME=${value}
      ;;
    hosted-cluster-namespace) # Get the hosted cluster namespace
      export HC_NAMESPACE=${value}
      ;;
    *)
      log "ERROR" "unknown parameter \"${key}\""
      exit 1
      ;;
    esac
    shift
  done
}

# verify_hypershift_binary confirms dest exists, is a non-empty ELF file, and is executable.
verify_hypershift_binary() {
  local bin="${1}"
  local magic=""

  [[ -s "${bin}" ]] || return 1
  # read returns non-zero when the first 4 bytes have no newline (expected for ELF).
  IFS= read -r -n 4 magic < "${bin}" || true
  [[ "${magic}" == $'\x7fELF' ]] || return 1
  chmod 755 "${bin}" || return 1
  [[ -x "${bin}" ]]
}

# copy_hypershift_via_image_extract pulls /usr/bin/hypershift out of the operator
# image without requiring tar, rsync, or cat in the running container.
copy_hypershift_via_image_extract() {
  local pod_name="${1}"
  local dest="${2}"
  local ho_image extract_dir os_arch

  ho_image="$(oc get "${pod_name}" -n hypershift -o json | jq -r '.spec.containers[] | select(.name=="operator") | .image' | head -n 1)"
  if [[ -z "${ho_image}" || "${ho_image}" == "null" ]]; then
    ho_image="$(oc get "${pod_name}" -n hypershift -o jsonpath='{.spec.containers[0].image}')"
  fi
  if [[ -z "${ho_image}" ]]; then
    log "WARN" "Unable to determine hypershift operator image for fallback extraction."
    return 1
  fi

  os_arch="$(uname -m)"
  case "${os_arch}" in
    x86_64) os_arch="amd64" ;;
    aarch64) os_arch="arm64" ;;
  esac

  extract_dir="$(mktemp -d /tmp/hypershift-extract.XXXXXX)" || return 1
  log "Trying to extract hypershift CLI from operator image ${ho_image}"
  if ! oc image extract "${ho_image}" --path "/usr/bin/hypershift:${extract_dir}" --filter-by-os="linux/${os_arch}" --confirm; then
    rm -rf "${extract_dir}"
    return 1
  fi

  if [[ -f "${extract_dir}/hypershift" ]]; then
    mv -f "${extract_dir}/hypershift" "${dest}"
  fi
  rm -rf "${extract_dir}"
  [[ -s "${dest}" ]]
}

ensure_hypershift_cli() {
  # First, check if the container image already contains the /usr/bin/hypershift
  if [ -f /usr/bin/hypershift ]; then
    log "Using hypershift binary at /usr/bin/hypershift."
    export HYPERSHIFT="/usr/bin/hypershift"
    return 0
  fi

  log "/usr/bin/hypershift is not found. Trying to extract it from the hypershift operator."

  # Now, try to extract the hypershift CLI from the hypershift operator
  if extract_hypershift_cli && [[ -x /tmp/hypershift ]]; then
    log "Successfully extracted the hypershift CLI binary to /tmp/hypershift."
    export HYPERSHIFT="/tmp/hypershift"
    return 0
  fi

  log "ERROR" "Extracting the hypershift binary from the hypershift operator failed."
  unset HYPERSHIFT
  return 1
}

extract_hypershift_cli() {
  local dest="/tmp/hypershift"

  if ! oc get namespace hypershift; then
    log "hypershift namespace not found"
    return 1
  fi

  # Get a running hypershift operator pod
  HO_POD_NAME=$(oc get pod -n hypershift --no-headers=true --field-selector=status.phase=Running -l app=operator -o name | head -n 1)

  if [[ -n "${HO_POD_NAME}" ]]; then
    log "Found a running hypershift operator pod: \"${HO_POD_NAME}\""
  else
    log "WARN" "No running hypershift operator pod found."
    return 1
  fi

  rm -f "${dest}"

  # Do not use oc rsync/oc cp: hypershift operator images are based on ubi-minimal and
  # typically omit tar and rsync, so those copy strategies fail with
  # "No available strategies to copy" while still looking successful.
  # Prefer oc exec (needs cat) and fall back to oc image extract (needs registry access).
  log "Copying hypershift CLI from ${HO_POD_NAME} using oc exec"
  if oc exec -n hypershift -c operator "${HO_POD_NAME}" -- cat /usr/bin/hypershift >"${dest}" &&
    verify_hypershift_binary "${dest}"; then
    return 0
  fi
  log "WARN" "Failed to copy a usable hypershift CLI from ${HO_POD_NAME} using oc exec."
  rm -f "${dest}"

  if copy_hypershift_via_image_extract "${HO_POD_NAME}" "${dest}" && verify_hypershift_binary "${dest}"; then
    return 0
  fi
  log "ERROR" "Failed to extract a usable hypershift CLI binary to ${dest}."
  rm -f "${dest}"
  return 1
}

dump_hostedcluster() {
  if [[ -z $HC_NAME ]]; then
    log "Hosted cluster name was not provided. Skip collecting hosted cluster must-gather."
    return 0
  fi

  HC=$(oc get hostedcluster "${HC_NAME}" -n "${HC_NAMESPACE}")
  if [[ -z $HC ]]; then
    log "ERROR" "hosted cluster \"$HC_NAME\" not found in \"$HC_NAMESPACE\" namespace"
    return 1
  fi

  # This could be the second time to be here if both MCE and spoke gathers are run.
  if [ -f "${BASE_COLLECTION_PATH}/hypershift-dump.tar.gz" ]; then
    log "Must-gather for hosted cluster \"$HC_NAME\" in namespace \"$HC_NAMESPACE\" has already been collected."
    return 0
  fi
  
  if ! ensure_hypershift_cli; then
    log "ERROR" "Failed to find a usable hypershift CLI binary. Skipping hosted cluster dump for '${HC_NAME}' in namespace '${HC_NAMESPACE}'."
    return 1
  fi

  log "Collecting must-gather for hosted cluster '${HC_NAME}' in namespace '${HC_NAMESPACE}'"
  hypershift_cmd=("${HYPERSHIFT}" dump cluster --artifact-dir "${BASE_COLLECTION_PATH}" --name "${HC_NAME}" --namespace "${HC_NAMESPACE}")
  if ! "${hypershift_cmd[@]}" --dump-guest-cluster; then
    log "WARN" "Failed to collect must-gather for hosted cluster '${HC_NAME}' in namespace '${HC_NAMESPACE}' using --dump-guest-cluster. Trying --dump-guest-cluster-through-kube-service."
    if ! "${hypershift_cmd[@]}" --dump-guest-cluster-through-kube-service; then
      log "ERROR" "Failed to collect must-gather for hosted cluster '${HC_NAME}' in namespace '${HC_NAMESPACE}' using --dump-guest-cluster-through-kube-service."
      return 1
    fi
  fi
}
